// FenPOS schema.
//
// FenPOS is the source of truth for all centrally managed state: agent identities,
// device configuration, API credentials, and job records. Agents hold only a cached copy of
// what the server pushed them. See
// docs/superpowers/specs/2026-08-18-fenpos-agent-design.md.
//
// SQLite does not support Prisma enums, so every closed value set is stored as TEXT and
// validated at the application boundary. The TypeScript unions in lib/domain/ are the
// single source of truth for those values; nothing else may widen them.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Singleton row holding the administrator record for this install: the one credential and
/// the identity that goes with it. The two live together because there is exactly one
/// administrator to have either, and nothing else yet needs to read one without the other.
/// Kept a singleton by the fixed primary key rather than by convention.
model AdminAuth {
  id                Int      @id @default(1)
  passwordHash      String   @map("password_hash")
  /// Shown in the sidebar footer and used for the avatar's initial. Non-null with a default so
  /// the one existing row migrates without a backfill and the footer always has something to draw.
  displayName       String   @default("Administrator") @map("display_name")
  /// Optional, and meaningfully so: "not set" is what a fresh install has, and it is what selects
  /// the locally drawn initial over a Gravatar request.
  email             String?
  /// True while the password is the one generated at first boot. While set, the panel is
  /// unreachable: signing in leads only to the page that replaces this password.
  isGenerated       Boolean  @default(false) @map("is_generated")
  /// The generated password in the clear, so it can be reprinted on every start for as long
  /// as it is still in use — an operator who missed the first boot's output should not have
  /// to reset the install to get back in.
  ///
  /// Deleted the moment an operator sets their own password, and never written for one they
  /// chose. It is readable in the database until then, which is the price of reprinting it;
  /// the same value is already in the startup log, and it cannot be used to reach anything
  /// except the page that replaces it.
  generatedPassword String?  @map("generated_password")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("admin_auth")
}

/// An authenticated admin browser session.
///
/// Stored server-side rather than encoded in a self-contained cookie so that sign-out and
/// password changes revoke immediately instead of waiting for expiry. Only the hash of the
/// session token is persisted: a database read must not yield usable credentials.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")

  @@index([expiresAt])
  @@map("sessions")
}

/// A printer agent: one machine with printers attached, at one physical location.
///
/// The status column is observed state, not desired state: it reflects whether the agent
/// currently holds a live WebSocket. It is reset to OFFLINE on startup, because
/// in-memory connection state does not survive a restart and a stale ONLINE would be a lie.
/// Values: PENDING | ONLINE | OFFLINE.
model Agent {
  id           String    @id @default(cuid())
  name         String    @unique
  status       String    @default("PENDING")
  /// SHA-256 of the long-lived bearer token issued at pairing. Never the token itself.
  /// Deterministic rather than salted, so the token can be resolved in one indexed lookup.
  /// The token is 256 bits of CSPRNG output and therefore has no brute-force surface for a
  /// slow KDF to defend; argon2 is for human-chosen passwords, not generated secrets.
  tokenHash    String?   @unique @map("token_hash")
  lastSeenAt   DateTime? @map("last_seen_at")
  agentVersion String?   @map("agent_version")
  platform     String?
  hostname     String?
  /// Address the agent most recently paired or connected from, surfaced in the panel so an
  /// unexpected pairing is visible to the administrator.
  lastAddress  String?   @map("last_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  devices      Device[]
  jobs         Job[]
  pairingCodes PairingCode[]
  logEntries   LogEntry[]

  @@index([status])
  @@map("agents")
}

/// A single-use, short-lived code that lets one agent claim one identity.
///
/// Consumed atomically at redemption rather than at first connect, so a code observed in
/// flight cannot be replayed. Rows are retained after consumption for the audit trail.
model PairingCode {
  id         String    @id @default(cuid())
  agentId    String    @map("agent_id")
  /// The formatted code, stored in the clear.
  ///
  /// Hashing was considered and rejected: the panel must be able to redisplay the code when
  /// the administrator navigates back to a pending agent, which a one-way hash forbids.
  /// Nothing is given up by storing it, because the code is single-use, expires in minutes,
  /// and is rate-limited at redemption — and anyone able to read this table already controls
  /// the server it belongs to.
  code       String    @unique
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([expiresAt])
  @@map("pairing_codes")
}

/// A thermal printer reachable through exactly one agent.
///
/// FenPOS owns this configuration and pushes it to the agent, which caches it so it can
/// keep printing through a disconnect. Names are unique per agent rather than globally,
/// which is what makes agent-scoped API paths work.
model Device {
  id      String @id @default(cuid())
  agentId String @map("agent_id")
  name    String

  // --- Serial transport ---
  port                  String
  baudRate              Int     @default(9600) @map("baud_rate")
  dataBits              Int     @default(8) @map("data_bits")
  stopBits              Int     @default(1) @map("stop_bits")
  /// NONE | ODD | EVEN | MARK | SPACE
  parity                String  @default("NONE")
  /// NONE | RTS | CTS | DSR | DTR | XONXOFF_IN | XONXOFF_OUT
  flowControl           String  @default("NONE") @map("flow_control")
  writeTimeoutMs        Int     @default(5000) @map("write_timeout_ms")
  autoConnect           Boolean @default(true) @map("auto_connect")
  autoReconnect         Boolean @default(true) @map("auto_reconnect")
  reconnectDelaySeconds Int     @default(5) @map("reconnect_delay_seconds")

  // --- Print behaviour ---
  /// Printable columns: 42 for 80mm paper, 32 for 58mm.
  columns         Int     @default(42)
  codepage        String  @default("CP858")
  /// REJECT | REPLACE | STRIP, for characters the codepage cannot represent.
  onUnsupported   String  @default("REJECT") @map("on_unsupported")
  defaultWrap     Boolean @default(true) @map("default_wrap")
  /// LF | CRLF | NONE
  defaultLinefeed String  @default("LF") @map("default_linefeed")

  // --- Per-device limit overrides. Null means inherit the global setting. ---
  maxBodyBytes   Int? @map("max_body_bytes")
  maxLines       Int? @map("max_lines")
  maxLineChars   Int? @map("max_line_chars")
  maxTotalChars  Int? @map("max_total_chars")
  maxOutputLines Int? @map("max_output_lines")
  maxQueueDepth  Int? @map("max_queue_depth")

  /// Desired state. Observed connection state lives in memory, reported by the agent.
  paused    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent      Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  jobs       Job[]
  keyGrants  ApiKeyDevice[]
  logEntries LogEntry[]

  @@unique([agentId, name])
  @@index([agentId])
  @@map("devices")
}

/// A bearer credential held by a machine client, typically a POS terminal.
///
/// Only the hash is stored; the plaintext is shown once at creation and never again.
/// A key grants nothing by default: both its device grants and its permissions are
/// explicit rows, so a freshly created key is inert rather than permissive.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  /// SHA-256 of the full key. Deterministic so an incoming bearer token resolves to its key
  /// in one indexed lookup rather than a scan-and-verify over every row.
  keyHash    String    @unique @map("key_hash")
  /// Short non-secret fragment for display, e.g. the last four characters.
  maskedHint String    @map("masked_hint")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  permissions ApiKeyPermission[]
  devices     ApiKeyDevice[]
  jobs        Job[]
  webhook     Webhook?

  @@index([revokedAt])
  @@map("api_keys")
}

/// One permission granted to one key. Absence of a row denies the action.
model ApiKeyPermission {
  apiKeyId   String @map("api_key_id")
  /// See PERMISSIONS in lib/domain/permissions.ts for the closed set.
  permission String

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, permission])
  @@map("api_key_permissions")
}

/// One device a key may address. Absence of a row denies access to that device.
model ApiKeyDevice {
  apiKeyId String @map("api_key_id")
  deviceId String @map("device_id")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, deviceId])
  @@index([deviceId])
  @@map("api_key_devices")
}

/// A print job lifecycle record.
///
/// Deliberately does not retain the submitted content: receipts carry customer data, and
/// the operational questions (did it print, how large was it, why did it fail) are all
/// answerable from metadata alone.
model Job {
  id       String  @id @default(cuid())
  agentId  String  @map("agent_id")
  deviceId String  @map("device_id")
  /// Null when the job originated from the admin panel rather than from an API key.
  apiKeyId String? @map("api_key_id")

  /// QUEUED | PRINTING | COMPLETED | FAILED | CANCELLED
  status String @default("QUEUED")

  submittedAt DateTime  @default(now()) @map("submitted_at")
  queuedAt    DateTime? @map("queued_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  /// Text lines after wrapping, i.e. the figure checked against maxOutputLines.
  lines Int?
  /// Size of the rendered ESC/POS payload.
  bytes Int?

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  /// The caller's `Idempotency-Key` header, when they sent one. Null for the great majority of
  /// jobs, and for every job the panel submits.
  ///
  /// The job row *is* the idempotency record: there is no second table with its own lifetime to
  /// keep in step. A key is therefore replayable for exactly as long as the job survives
  /// `jobs.retentionMinutes` and `jobs.maxRecords`, and is free again afterwards. That coupling is
  /// deliberate — an idempotency record that outlived the job it names would answer a retry by
  /// describing something no longer in the system.
  idempotencyKey  String? @map("idempotency_key")
  /// SHA-256 of the request body the key was first used with.
  ///
  /// Without it, the same key with a different receipt would replay the first one and silently
  /// print the wrong thing. With it, that request is refused as a conflict, which is the only answer
  /// that keeps the header's guarantee meaningful.
  idempotencyHash String? @map("idempotency_hash")

  agent  Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  device Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([deviceId, submittedAt])
  @@index([agentId, submittedAt])
  /// Scoped to the key, so two integrators may each use "order-1041" without colliding. Null keys
  /// do not participate: SQLite treats NULLs as distinct in a unique index, which is exactly what
  /// is wanted — every job without a key is unconstrained.
  @@unique([apiKeyId, idempotencyKey])
  @@map("jobs")
}

/// An operational log line, either raised by the server or forwarded from an agent.
///
/// Ingestion from agents is rate-limited and length-capped at the protocol boundary. This
/// table must never become a channel through which an agent can exhaust the disk.
model LogEntry {
  id       String   @id @default(cuid())
  ts       DateTime @default(now())
  /// DEBUG | INFO | WARN | ERROR
  level    String
  /// DEBUG 0, INFO 1, WARN 2, ERROR 3. Derived from level when the row is written.
  ///
  /// Stored rather than computed because both the severity filter and the Level column ordering
  /// need it in the database: ordering the level string gives DEBUG, ERROR, INFO, WARN, which
  /// looks like severity and is not, and a page of rows cannot be reordered after the fact.
  severity Int      @default(1)
  message  String
  agentId  String?  @map("agent_id")
  deviceId String?  @map("device_id")

  agent  Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([ts])
  @@index([severity, ts])
  @@index([agentId, ts])
  @@map("log_entries")
}

/// Global configuration, replacing the removed config.yaml.
///
/// Values are stored as JSON text and parsed against the schema in lib/domain/settings.ts,
/// so a malformed or stale row surfaces as a validation error rather than as undefined
/// behaviour deep in the print path.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Asset {
  id        String   @id @default(cuid())
  /// IMAGE. See AssetKind in lib/domain/enums.ts for the closed set.
  kind      String   @default("IMAGE")
  /// Referenced from markup. Slug-shaped.
  name      String
  /// The uploaded file, untouched. Dithered output is derived from this, never stored as the
  /// source of truth, because the right dither depends on the paper it is going to.
  data      Bytes
  mimeType  String   @map("mime_type")
  /// Pixel dimensions, for kinds that are rasters. Null otherwise.
  width     Int?
  height    Int?
  /// Set when imported from a URL, for provenance only. Not re-fetched.
  sourceUrl String?  @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Unique per kind rather than globally, so a later kind may reuse a name that reads naturally
  /// for it without colliding with an image.
  @@unique([kind, name])
  @@map("assets")
}

/// Where one API key's job outcomes are delivered.
///
/// One row per key, registered through the admin panel rather than through the API. A key able to
/// register its own callback could, if it leaked, redirect another integrator's notifications; the
/// operator who granted the key is the right person to say where its events go.
model Webhook {
  id       String  @id @default(cuid())
  apiKeyId String  @unique @map("api_key_id")
  url      String
  /// Shared secret for the HMAC signature, generated here and shown once. The receiver needs the
  /// plaintext to verify, so unlike a credential this server checks, it cannot be stored hashed.
  secret   String
  enabled  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKey     ApiKey            @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

/// One attempted delivery of one job outcome.
///
/// Persisted rather than held in memory so a restart does not silently drop everything in flight —
/// a notification that vanishes is worse than one that arrives late, because the receiver has no
/// way to know it is waiting for something that will never come.
model WebhookDelivery {
  id        String @id @default(cuid())
  webhookId String @map("webhook_id")
  /// The job this delivery is about. Not a relation: the job may be swept by retention while a
  /// delivery is still being retried, and losing the delivery record with it would hide the failure.
  jobId     String @map("job_id")
  /// The signed body, exactly as it will be sent. Frozen at queue time so a retry delivers what the
  /// job looked like when it settled rather than what it looks like now.
  payload   String

  /// PENDING | DELIVERED | FAILED
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lastError    String?   @map("last_error")
  deliveredAt  DateTime? @map("delivered_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([webhookId])
  /// The settle paths that queue a delivery are not exactly-once — an agent can report a terminal
  /// status twice, and nothing serialises frame processing between them. This constraint is what
  /// turns "one settle, one delivery" from a race the application code hopes to win into a fact the
  /// database enforces: whichever of two concurrent inserts for the same job arrives second is
  /// refused, not silently duplicated.
  @@unique([webhookId, jobId])
  @@map("webhook_deliveries")
}
