// FenPOS schema.
//
// FenPOS is the source of truth for all centrally managed state: agent identities,
// device configuration, API credentials, and job records. Agents hold only a cached copy of
// what the server pushed them. See
// docs/superpowers/specs/2026-08-18-fenpos-agent-design.md.
//
// SQLite does not support Prisma enums, so every closed value set is stored as TEXT and
// validated at the application boundary. The TypeScript unions in lib/domain/ are the
// single source of truth for those values; nothing else may widen them.
//
// user, session, account, verification and two_factor (the TwoFactor model, mapped to the
// camelCase table "twoFactor") are not FenPOS's to edit — they are owned by Better Auth, and
// their column names come from its own generator rather than this project's house style. They
// were derived from @better-auth/core 1.7.1's actual table definitions, confirmed by running
// `@better-auth/cli generate` against this project's real Better Auth config rather than by
// hand-transcribing the docs. That check mattered: a hand-drafted version of this same schema,
// written before that generator was run, used the wrong table-name casing for the two-factor
// table and was missing three of its columns (verified, failedVerificationCount, lockedUntil),
// and would have shipped that way had the generated output not been compared against it first.
// `@better-auth/cli` itself carries an npm deprecation notice ("Package no longer supported") —
// it still produces a correct schema, but do not trust it, or a hand-written guess, blindly:
// regenerate and diff against a real run before touching these five models again.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A panel user.
///
/// Owned by Better Auth: every column below the FenPOS block is its schema, and renaming one
/// breaks the adapter's queries rather than producing a type error. These five models were emitted
/// by `@better-auth/cli generate` against better-auth 1.7.1 and are transcribed verbatim, which is
/// why they carry camelCase columns while the rest of this file is snake_case — a hand-applied
/// style layer would turn every future regeneration into a merge conflict.
///
/// There is no self-registration path. A row is created by first-run setup or by the admin
/// plugin's `createUser`, and by nothing else — `emailAndPassword.disableSignUp` in
/// `lib/auth/auth.ts` is what makes that true rather than merely intended.
model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  /// Better Auth's own avatar field. Unused: FenPOS serves avatars from its own table so the bytes
  /// live in the same file as everything else that is backed up.
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // --- twoFactor plugin ---
  twoFactorEnabled Boolean?    @default(false)

  // --- admin plugin ---
  /// Better Auth's own role string, read only by the admin plugin's endpoints. FenPOS
  /// authorisation reads `isSuperuser` and, from Phase 3, the permission tables. The two must not
  /// be mistaken for one another.
  role             String?
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?

  // --- FenPOS ---
  /// Bypasses every permission check. Written by first-run setup, and afterwards only by another
  /// superuser. Declared to Better Auth with `input: false`, so no request body can set it.
  isSuperuser        Boolean @default(false)
  /// Blocks every panel route except the one that replaces the password. Set by the "Require
  /// password reset" checkbox at creation, or by the force-reset action later.
  mustChangePassword Boolean @default(false)
  /// When the password was last replaced, for `auth.passwordExpiryDays`. Null on an account whose
  /// password predates this column, and that reads as "never expires" rather than as "expired
  /// immediately" — the alternative would force a password change across the whole install the
  /// moment somebody turned the setting on.
  passwordChangedAt  DateTime? @map("password_changed_at")
  /// Consecutive failed sign-ins, for `auth.lockoutAfterFailures`. Reset to zero on any success.
  failedSignInCount  Int       @default(0) @map("failed_sign_in_count")
  /// When an account lock lifts on its own. Null means not locked; nobody has to clear it.
  lockedUntil        DateTime? @map("locked_until")

  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]
  /// Roles this account belongs to, and grants made to it directly. Both cascade on delete: a
  /// grant is a statement about an account that exists, and outlives nothing. The audit trail is
  /// the deliberate opposite — see `AuditEvent`.
  roles       UserRole[]
  permissions UserPermission[]
  /// Hashes of passwords this account may not return to. Cascades, unlike the audit trail: a
  /// deleted account's old hashes protect nobody and are only a liability to keep.
  passwordHistory PasswordHistory[]

  @@unique([email])
  @@map("user")
}

/// Previous passwords an account may not return to, for `auth.passwordReuseCount`.
///
/// Hashes, never plaintext and never a reversible digest: this table is exactly as sensitive as
/// `account.password` and is treated the same. Written on every password change including the
/// first, so that turning the setting on later has something to compare against rather than
/// starting blind.
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A PHC-format argon2id string, written by `hashPassword` like every other password here.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("password_history")
}

/// An authenticated browser session.
///
/// A row rather than a self-contained signed cookie, and that is the property this whole rebuild
/// was chosen around: signing out, changing a password, or banning an account revokes access at
/// once instead of leaving a valid token in the wild until it expires. For a panel that can pause
/// printers and write raw bytes to hardware, that trade is the right way round.
model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set by the admin plugin while an administrator is impersonating this user. Non-null means the
  /// session is not what it appears to be, which is exactly what the audit log needs to say.
  impersonatedBy String?

  // --- FenPOS, via session.additionalFields in lib/auth/auth.ts ---
  // Nullable because Better Auth wrote every row that existed before this column did, and a session
  // in flight when the migration ran must not be judged idle on a timestamp it never had. Readers
  // fall back to updatedAt.
  lastSeenAt DateTime?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// One authentication method belonging to one user.
///
/// For email and password there is exactly one row per user and `password` holds the argon2id hash
/// — Better Auth's own default hasher is replaced in `lib/auth/auth.ts`. The OAuth token columns
/// are unused and stay because the adapter expects them.
///
/// `issuer` is the column the library actually keys an account by, not `providerId`. Two rows can
/// share a `providerId` — a second OAuth app against the same social provider, say — but the pair
/// `[issuer, accountId]` is what `findAccountByKey` looks up and what has to stay unique, so that is
/// where the constraint sits. For the credential provider every row gets the same constant,
/// `local:credential`, which is why the column reads as a redundant copy of `providerId` in a
/// single-provider install today: it is not one, it is the join key `linkAccount` and sign-in use,
/// and dropping it would only fail once a second provider existed to collide on `providerId` alone.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

/// Short-lived verification tokens Better Auth issues internally.
///
/// Nothing in FenPOS sends email, so this holds only what the two-factor flow puts there.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// One user's TOTP enrolment, their recovery codes, and the lockout state guarding both.
///
/// Wired in Phase 6. The table ships now so that adding the two-factor plugin later needs no second
/// migration touching the user table — which is also why the columns Phase 6 will use are present
/// in full rather than trimmed to the two that look essential today.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

/// The credential that claims an unconfigured install.
///
/// A singleton by fixed primary key, holding only a hash: unlike the administrator password this
/// replaces, the plaintext is never stored. While the install is unclaimed the key is regenerated
/// on every boot, so an operator who missed the startup message restarts to get a fresh one — which
/// is why storing the plaintext in order to reprint it, as `admin_auth` did, is no longer
/// necessary. A key someone glimpsed dies at the next restart.
///
/// The row's existence is one half of the condition under which setup is permitted; the other half
/// is that no user exists. `completeSetup` (`lib/auth/setup.ts`) checks both inside one transaction
/// and deletes this row in the same one, which is what makes setup unrepeatable.
///
/// Snake_case columns, unlike the five models above: nothing regenerates this one, so it follows
/// the house style the rest of this file uses.
model SetupKey {
  id        Int      @id @default(1)
  keyHash   String   @map("key_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("setup_key")
}

/// A named bundle of permissions that accounts can be given all at once.
///
/// Roles are additive to individual grants rather than a replacement for them: an account's
/// effective set is the union of every role it holds and every permission granted to it directly.
/// There is no "deny" row and no precedence to reason about, which is the whole reason the union is
/// safe to compute in one pass — a permission is held or it is not.
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  members     UserRole[]

  @@map("roles")
}

/// One permission carried by one role.
///
/// A row per grant rather than a delimited column, so a role with no rows carries nothing — the
/// same default `ApiKeyPermission` already establishes, and for the same reason: a role created but
/// not yet configured must be inert.
model RolePermission {
  roleId     String @map("role_id")
  /// See PanelPermission in lib/domain/panel-permissions.ts. Stored as TEXT; an identifier this
  /// version no longer recognises is dropped on read rather than honoured.
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([permission])
  @@map("role_permissions")
}

/// One account's membership of one role.
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// One permission granted to one account directly, on top of whatever its roles carry.
///
/// Individual grants exist so an operator can hand somebody one extra capability without inventing
/// a role for it. They are additive only: there is no way to subtract a permission a role confers,
/// because a subtraction is a rule two people have to hold in their heads at once and a union is
/// not.
model UserPermission {
  userId     String @map("user_id")
  /// See PanelPermission in lib/domain/panel-permissions.ts.
  permission String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@index([permission])
  @@map("user_permissions")
}

/// A printer agent: one machine with printers attached, at one physical location.
///
/// The status column is observed state, not desired state: it reflects whether the agent
/// currently holds a live WebSocket. It is reset to OFFLINE on startup, because
/// in-memory connection state does not survive a restart and a stale ONLINE would be a lie.
/// Values: PENDING | ONLINE | OFFLINE.
model Agent {
  id           String    @id @default(cuid())
  name         String    @unique
  status       String    @default("PENDING")
  /// SHA-256 of the long-lived bearer token issued at pairing. Never the token itself.
  /// Deterministic rather than salted, so the token can be resolved in one indexed lookup.
  /// The token is 256 bits of CSPRNG output and therefore has no brute-force surface for a
  /// slow KDF to defend; argon2 is for human-chosen passwords, not generated secrets.
  tokenHash    String?   @unique @map("token_hash")
  lastSeenAt   DateTime? @map("last_seen_at")
  agentVersion String?   @map("agent_version")
  platform     String?
  hostname     String?
  /// Address the agent most recently paired or connected from, surfaced in the panel so an
  /// unexpected pairing is visible to the administrator.
  lastAddress  String?   @map("last_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  devices      Device[]
  jobs         Job[]
  pairingCodes PairingCode[]

  @@index([status])
  @@map("agents")
}

/// A single-use, short-lived code that lets one agent claim one identity.
///
/// Consumed atomically at redemption rather than at first connect, so a code observed in
/// flight cannot be replayed. Rows are retained after consumption for the audit trail.
model PairingCode {
  id         String    @id @default(cuid())
  agentId    String    @map("agent_id")
  /// The formatted code, stored in the clear.
  ///
  /// Hashing was considered and rejected: the panel must be able to redisplay the code when
  /// the administrator navigates back to a pending agent, which a one-way hash forbids.
  /// Nothing is given up by storing it, because the code is single-use, expires in minutes,
  /// and is rate-limited at redemption — and anyone able to read this table already controls
  /// the server it belongs to.
  code       String    @unique
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([expiresAt])
  @@map("pairing_codes")
}

/// A thermal printer reachable through exactly one agent.
///
/// FenPOS owns this configuration and pushes it to the agent, which caches it so it can
/// keep printing through a disconnect. Names are unique per agent rather than globally,
/// which is what makes agent-scoped API paths work.
model Device {
  id      String @id @default(cuid())
  agentId String @map("agent_id")
  name    String

  // --- Serial transport ---
  port                  String
  baudRate              Int     @default(9600) @map("baud_rate")
  dataBits              Int     @default(8) @map("data_bits")
  stopBits              Int     @default(1) @map("stop_bits")
  /// NONE | ODD | EVEN | MARK | SPACE
  parity                String  @default("NONE")
  /// NONE | RTS | CTS | DSR | DTR | XONXOFF_IN | XONXOFF_OUT
  flowControl           String  @default("NONE") @map("flow_control")
  writeTimeoutMs        Int     @default(5000) @map("write_timeout_ms")
  autoConnect           Boolean @default(true) @map("auto_connect")
  autoReconnect         Boolean @default(true) @map("auto_reconnect")
  reconnectDelaySeconds Int     @default(5) @map("reconnect_delay_seconds")

  // --- Print behaviour ---
  /// Printable columns: 42 for 80mm paper, 32 for 58mm.
  columns         Int     @default(42)
  codepage        String  @default("CP858")
  /// REJECT | REPLACE | STRIP, for characters the codepage cannot represent.
  onUnsupported   String  @default("REJECT") @map("on_unsupported")
  defaultWrap     Boolean @default(true) @map("default_wrap")
  /// LF | CRLF | NONE
  defaultLinefeed String  @default("LF") @map("default_linefeed")

  // --- Per-device limit overrides. Null means inherit the global setting. ---
  maxBodyBytes   Int? @map("max_body_bytes")
  maxLines       Int? @map("max_lines")
  maxLineChars   Int? @map("max_line_chars")
  maxTotalChars  Int? @map("max_total_chars")
  maxOutputLines Int? @map("max_output_lines")
  maxQueueDepth  Int? @map("max_queue_depth")

  /// Desired state. Observed connection state lives in memory, reported by the agent.
  paused    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent          Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  jobs           Job[]
  keyGrants      ApiKeyDevice[]
  variableValues DeviceVariable[]

  @@unique([agentId, name])
  @@index([agentId])
  @@map("devices")
}

/// A bearer credential held by a machine client, typically a POS terminal.
///
/// Only the hash is stored; the plaintext is shown once at creation and never again.
/// A key grants nothing by default: both its device grants and its permissions are
/// explicit rows, so a freshly created key is inert rather than permissive.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  /// SHA-256 of the full key. Deterministic so an incoming bearer token resolves to its key
  /// in one indexed lookup rather than a scan-and-verify over every row.
  keyHash    String    @unique @map("key_hash")
  /// Short non-secret fragment for display, e.g. the last four characters.
  maskedHint String    @map("masked_hint")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Who minted this key, and what they were called at the time.
  ///
  /// Plain columns rather than a relation, and denormalised on purpose: a key must outlive the
  /// account that created it while still naming who that was. A foreign key would either take the
  /// key with the account or keep the key and lose the name, and neither is what an operator
  /// looking at a live credential needs to know. Null for keys minted before this column existed,
  /// which the panel renders as "unknown" rather than guessing.
  createdByUserId String? @map("created_by_user_id")
  createdByName   String? @map("created_by_name")

  permissions ApiKeyPermission[]
  devices     ApiKeyDevice[]
  jobs        Job[]
  webhook     Webhook?

  @@index([revokedAt])
  @@map("api_keys")
}

/// One permission granted to one key. Absence of a row denies the action.
model ApiKeyPermission {
  apiKeyId   String @map("api_key_id")
  /// See PERMISSIONS in lib/domain/permissions.ts for the closed set.
  permission String

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, permission])
  @@map("api_key_permissions")
}

/// One device a key may address. Absence of a row denies access to that device.
model ApiKeyDevice {
  apiKeyId String @map("api_key_id")
  deviceId String @map("device_id")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, deviceId])
  @@index([deviceId])
  @@map("api_key_devices")
}

/// A print job lifecycle record.
///
/// Deliberately does not retain the submitted content: receipts carry customer data, and
/// the operational questions (did it print, how large was it, why did it fail) are all
/// answerable from metadata alone.
model Job {
  id       String  @id @default(cuid())
  agentId  String  @map("agent_id")
  deviceId String  @map("device_id")
  /// Null when the job originated from the admin panel rather than from an API key.
  apiKeyId String? @map("api_key_id")

  /// QUEUED | PRINTING | COMPLETED | FAILED | CANCELLED
  status String @default("QUEUED")

  submittedAt DateTime  @default(now()) @map("submitted_at")
  queuedAt    DateTime? @map("queued_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")

  /// Text lines after wrapping, i.e. the figure checked against maxOutputLines.
  lines Int?
  /// Size of the rendered ESC/POS payload.
  bytes Int?

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message")

  /// The caller's `Idempotency-Key` header, when they sent one. Null for the great majority of
  /// jobs, and for every job the panel submits.
  ///
  /// The job row *is* the idempotency record: there is no second table with its own lifetime to
  /// keep in step, so a key can never outlive the job it names. Nothing sweeps this table today,
  /// though — `jobs.retentionMinutes` and `jobs.maxRecords` bound only what is pushed to each
  /// agent's own local job store — so in practice a key is retained forever rather than freed after
  /// some window. Integrators are told to use a for-all-time-unique key accordingly.
  idempotencyKey  String? @map("idempotency_key")
  /// SHA-256 of the request body the key was first used with.
  ///
  /// Without it, the same key with a different receipt would replay the first one and silently
  /// print the wrong thing. With it, that request is refused as a conflict, which is the only answer
  /// that keeps the header's guarantee meaningful.
  idempotencyHash String? @map("idempotency_hash")

  agent  Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  device Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedAt])
  @@index([deviceId, submittedAt])
  @@index([agentId, submittedAt])
  /// Scoped to the key, so two integrators may each use "order-1041" without colliding. Null keys
  /// do not participate: SQLite treats NULLs as distinct in a unique index, which is exactly what
  /// is wanted — every job without a key is unconstrained.
  @@unique([apiKeyId, idempotencyKey])
  @@map("jobs")
}

// LogEntry lived here until log volume proved able to evict the rows kept beside it. It now has
// its own database and its own migration history — see prisma/logs.prisma — so its retention is
// bounded on its own budget. Nothing in this file may relate to it: the two files cannot be
// joined, and a log line's agent and device are plain id columns over there.

/// Global configuration, replacing the removed config.yaml.
///
/// Values are stored as JSON text and parsed against the schema in lib/domain/settings.ts,
/// so a malformed or stale row surfaces as a validation error rather than as undefined
/// behaviour deep in the print path.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// One thing somebody did, and what came of it.
///
/// Append-only. There is no delete or edit path in the application, for superusers either — the
/// only deletion that exists is the retention sweep, which runs oldest-first and re-anchors the
/// chain behind it. The threat this shape defends against is explicit: an attacker who has
/// obtained superuser credentials and wants to erase what they did.
///
/// **Every row hashes itself together with the row before it.** `hash` is SHA-256 over this row's
/// canonical fields and `prevHash` — see `lib/audit/chain.ts`, which owns the field order and is
/// the only place that may change it. Editing any covered column breaks that row's hash; removing
/// a row breaks the next row's link. Neither is repairable without recomputing every hash after
/// the change, which requires the application's own hashing code rather than database access.
///
/// **What this does not detect: truncation at the tail.** Deleting the newest rows leaves a chain
/// that verifies perfectly, because nothing in the table records how long it should be. That is
/// inherent to a self-contained chain and is stated here rather than left for someone to discover:
/// detecting it needs state kept somewhere the attacker does not control.
///
/// The actor is denormalised into plain columns rather than a relation, deliberately: deleting a
/// user must not delete or blank their trail. `WebhookDelivery.jobId` already establishes that
/// pattern in this schema and for the same reason — a record whose whole purpose is to survive is
/// one that must not cascade.
model AuditEvent {
  /// The chain's ordering, and the row's identity. Autoincrement, so a gap means a row was removed.
  seq         Int      @id @default(autoincrement())
  /// Always written explicitly by `recordAudit`, never left to this default: the hash covers this
  /// value, so the timestamp that was hashed and the timestamp that was stored must be the same
  /// one. The default exists only so a hand-written row in a test is not a type error.
  at          DateTime @default(now())
  /// USER | API_KEY | SYSTEM | SETUP | CLI. See ActorKind in lib/domain/audit.ts.
  actorKind   String   @map("actor_kind")
  /// Null for a failed sign-in against an address that matches no account, and for every non-USER
  /// actor. A plain column, not a relation — see the model comment.
  actorUserId String?  @map("actor_user_id")
  actorName   String?  @map("actor_name")
  /// Recorded even when `actorUserId` is null: on a refused sign-in, the address that was tried is
  /// the single most useful thing in the row.
  actorEmail  String?  @map("actor_email")
  apiKeyId    String?  @map("api_key_id")
  apiKeyName  String?  @map("api_key_name")
  /// Registry id, e.g. `devices:delete`. Free text at this phase; phase 3's action registry becomes
  /// the authority for panel-action ids.
  action      String
  targetKind  String?  @map("target_kind")
  targetId    String?  @map("target_id")
  /// Denormalised for the same reason the actor is: a deleted device's name must survive it.
  targetLabel String?  @map("target_label")
  /// SUCCESS | DENIED | FAILURE. See AuditOutcome in lib/domain/audit.ts.
  outcome     String
  /// JSON text: parameters, before and after where meaningful, error text. Redacted through
  /// `lib/redact.ts` before it is serialised, so this column and the process log cannot disagree
  /// about what is unsafe to record.
  detail      String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  sessionId   String?  @map("session_id")
  /// The previous row's `hash`, or the genesis constant for the first row.
  ///
  /// **Unique, and that is what makes the chain safe under concurrency without a lock.** Two
  /// writers that read the same tail cannot both commit; the second gets a constraint violation and
  /// retries against the row the first wrote. A forked chain stops being a race the application
  /// hopes to win and becomes something the database refuses — the same reasoning
  /// `WebhookDelivery`'s `@@unique([webhookId, jobId])` already applies to duplicate deliveries.
  prevHash    String   @unique @map("prev_hash")
  /// SHA-256 over this row's canonical fields plus `prevHash`. Unique because two identical rows
  /// are not a thing that can honestly happen: they would have to share a predecessor.
  hash        String   @unique

  @@index([at])
  @@index([action, at])
  @@index([actorUserId, at])
  @@index([outcome, at])
  @@map("audit_events")
}

/// The chain state immediately before the oldest retained event.
///
/// A singleton, kept so by its fixed primary key. Retention deletes from the front of the chain, so
/// without this the oldest surviving row would have a `prevHash` pointing at something that no
/// longer exists and verification could not tell that from tampering. This records what was there.
///
/// Written by the retention sweep, which arrives in phase 5. Until then no row exists, and
/// `verifyAuditChain` reads its absence as "the chain still starts at genesis" — which, on an
/// install that has never swept, is exactly true.
model AuditAnchor {
  id        Int      @id @default(1)
  /// `seq` of the last swept event.
  seq       Int
  /// That event's `hash`, which the oldest retained event's `prevHash` must equal.
  hash      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_anchor")
}

model Asset {
  id        String   @id @default(cuid())
  /// IMAGE. See AssetKind in lib/domain/enums.ts for the closed set.
  kind      String   @default("IMAGE")
  /// Referenced from markup. Slug-shaped.
  name      String
  /// The uploaded file, untouched. Dithered output is derived from this, never stored as the
  /// source of truth, because the right dither depends on the paper it is going to.
  data      Bytes
  mimeType  String   @map("mime_type")
  /// Pixel dimensions, for kinds that are rasters. Null otherwise.
  width     Int?
  height    Int?
  /// Set when imported from a URL, for provenance only. Not re-fetched.
  sourceUrl String?  @map("source_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Unique per kind rather than globally, so a later kind may reuse a name that reads naturally
  /// for it without colliding with an image.
  @@unique([kind, name])
  @@map("assets")
}

/// A named value receipts refer to as `{name}`.
///
/// A discriminated union over `kind`, flattened into nullable columns because SQLite has no
/// variants and a table per kind buys nothing at three of them. The cross-field rules — a STATIC
/// row has a value and nothing else, a DATETIME has a pattern — are enforced by
/// `variableDefinitionSchema` in lib/variables/definition.ts, which every write goes through.
///
/// Resolved entirely on this side. A compiled job crosses the link with every reference already
/// substituted into spans, so nothing here has an agent-side counterpart to stay in step with.
model Variable {
  id           String   @id @default(cuid())
  /// Referenced from markup. Slug-shaped, validated by nameSchema in lib/domain/naming.ts.
  name         String   @unique
  /// STATIC | DATETIME | CONTEXT. See VariableKind in lib/variables/definition.ts.
  kind         String
  /// STATIC only: the literal text, substituted exactly and never re-read as markup.
  value        String?
  /// DATETIME only: a date-fns format pattern, e.g. "HH:mm:ss".
  pattern      String?
  /// DATETIME only: signed shift applied before formatting. Null for no shift.
  offsetAmount Int?     @map("offset_amount")
  /// DATETIME only: MINUTES | HOURS | DAYS | WEEKS | MONTHS.
  offsetUnit   String?  @map("offset_unit")
  /// CONTEXT only: DEVICE_NAME | AGENT_NAME | API_KEY_NAME.
  source       String?
  /// Whether a print request may supply its own value for this name.
  ///
  /// Defaults to false, and that default is the point: a store's phone number is exactly the kind
  /// of value that should not be silently replaceable by whatever fed the POS. Opening one up is a
  /// deliberate act per variable.
  overridable  Boolean  @default(false)
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  deviceValues DeviceVariable[]

  @@map("variables")
}

/// One printer's own value for one variable.
///
/// Restricted to STATIC variables, enforced on write rather than by the schema: overriding a
/// printer's `{location}` is the real case, while "this printer formats time differently" is not,
/// and allowing it would mean this row could carry a pattern needing its own validation.
model DeviceVariable {
  deviceId   String @map("device_id")
  variableId String @map("variable_id")
  value      String

  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  variable Variable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@id([deviceId, variableId])
  @@index([variableId])
  @@map("device_variables")
}

/// Where one API key's job outcomes are delivered.
///
/// One row per key, registered through the admin panel rather than through the API. A key able to
/// register its own callback could, if it leaked, redirect another integrator's notifications; the
/// operator who granted the key is the right person to say where its events go.
model Webhook {
  id       String  @id @default(cuid())
  apiKeyId String  @unique @map("api_key_id")
  url      String
  /// Shared secret for the HMAC signature, generated here and shown once. The receiver needs the
  /// plaintext to verify, so unlike a credential this server checks, it cannot be stored hashed.
  secret   String
  enabled  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKey     ApiKey            @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

/// One attempted delivery of one job outcome.
///
/// Persisted rather than held in memory so a restart does not silently drop everything in flight —
/// a notification that vanishes is worse than one that arrives late, because the receiver has no
/// way to know it is waiting for something that will never come.
model WebhookDelivery {
  id        String @id @default(cuid())
  webhookId String @map("webhook_id")
  /// The job this delivery is about. Not a relation: the job row is cascade-deleted when its device
  /// or agent is deleted, and a delivery must be able to outlive that — losing the delivery record
  /// with it would hide the failure.
  jobId     String @map("job_id")
  /// The signed body, exactly as it will be sent. Frozen at queue time so a retry delivers what the
  /// job looked like when it settled rather than what it looks like now.
  payload   String

  /// PENDING | DELIVERED | FAILED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  /// The settle paths that queue a delivery are not exactly-once — an agent can report a terminal
  /// status twice, and nothing serialises frame processing between them. This constraint is what
  /// turns "one settle, one delivery" from a race the application code hopes to win into a fact the
  /// database enforces: whichever of two concurrent inserts for the same job arrives second is
  /// refused, not silently duplicated.
  @@unique([webhookId, jobId])
  @@index([status, nextAttemptAt])
  @@index([webhookId])
  @@map("webhook_deliveries")
}
