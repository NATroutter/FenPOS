# SQLite database file. Relative paths resolve from the fenpos/ directory.
# In Docker this should point at a mounted volume so data survives a container rebuild.
#
# Log lines live in logs.db in the same directory, so that a burst of log noise cannot evict
# what is stored beside it. The path is derived from this one and is not configured separately:
# whatever volume this file is on is the volume the whole record is on.
DATABASE_URL="file:./data/fenpos.db"

# Signing key for panel sessions. Required. Generate with: openssl rand -base64 32
# Changing it signs everyone out; losing it is not recoverable, only replaceable.
BETTER_AUTH_SECRET=

# Absolute origin the panel is reached on. Leave unset to derive it from the request,
# which is right for a LAN install. Set it when a proxy rewrites the Host header.
# BETTER_AUTH_URL=https://pos.example.com

# Port the combined Next.js + WebSocket server listens on.
PORT=3000
