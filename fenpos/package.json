{
	"name": "fenpos",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "tsx server.ts",
		"dev:clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && tsx server.ts",
		"build": "next build",
		"start": "tsx server.ts",
		"lint": "biome check",
		"format": "biome format --write",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:seed": "tsx scripts/seed-demo-data.ts",
		"db:seed:clean": "tsx scripts/seed-demo-data.ts --clean",
		"admin:set-password": "tsx scripts/set-admin-password.ts",
		"admin:reset-password": "tsx scripts/reset-admin-password.ts",
		"db:reset": "prisma migrate reset"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@hookform/resolvers": "^5.9.1",
		"@node-rs/argon2": "^2.1.0",
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@tanstack/react-table": "^9.1.2",
		"@uiw/react-codemirror": "^4.25.11",
		"bwip-js": "^4.11.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"iconv-lite": "^0.7.3",
		"jimp": "^1.6.1",
		"lucide-react": "^1.31.0",
		"next": "16.3.1",
		"next-themes": "^0.4.6",
		"prisma": "^7.9.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "^7.85.0",
		"server-only": "^0.0.1",
		"shadcn": "^4.18.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tsx": "^4.23.12",
		"tw-animate-css": "^1.4.0",
		"ws": "^8.21.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.2",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/ws": "^8.18.1",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.9.0"
}
