# Keep the build context small, and make sure a local build can never leak into
# the image: target/ here would otherwise be copied over the one built inside.
target/
logs/
FoxFrame/
.git/
.github/
.idea/
docs/
*.md
*.iml

# The agent's identity — server address and pairing credential — belongs to the
# host volume, never to an image. An image carrying one would pair every copy of
# itself as the same agent.
data/
.env
